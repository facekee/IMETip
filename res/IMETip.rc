#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDI_APP ICON "IMETip.ico"

// 以 Invoker 权限运行 + PerMonitorV2 DPI 感知
1 RT_MANIFEST "IMETip.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,3,0
 PRODUCTVERSION 0,1,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "IMETip contributors"
            VALUE "FileDescription", "IMETip - 输入法状态提示"
            VALUE "FileVersion", "0.1.3.0"
            VALUE "InternalName", "IMETip"
            VALUE "LegalCopyright", "Copyright (C) 2026 IMETip contributors"
            VALUE "OriginalFilename", "IMETip.exe"
            VALUE "ProductName", "IMETip"
            VALUE "ProductVersion", "0.1.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
